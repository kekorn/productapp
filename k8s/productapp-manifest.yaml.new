apiVersion: v1
kind: Service
metadata:
  name: mongodb
spec:
  selector:
    app: mongodb
  ports:
    - protocol: TCP
      port: 27017
      targetPort: 27017
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mongodb
spec:
  selector:
    matchLabels:
      app: mongodb
  template:
    metadata:
      labels:
        app: mongodb
    spec:
      containers:
      - name: mongodb
        image: kekorn/productapp-mongo:latest
        imagePullPolicy: Always
        env:
        - name: MONGO_INITDB_DATABASE
          value: ProductApp
        ports:
        - containerPort: 27017
---
apiVersion: v1
kind: Service
metadata:
  name: webapi
spec:
  selector:
    app: webapi
  ports:
    - protocol: TCP
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: webapi
spec:
  selector:
    matchLabels:
      app: webapi
  template:
    metadata:
      labels:
        app: webapi
    spec:
      containers:
      - name: webapi
        image: kekorn/productapp-webapi
        imagePullPolicy: Always
        env:
        - name: ASPNETCORE_ENVIRONMENT
          value: "Production"
        - name: ConnectionStrings__MongoDB
          value: "mongodb://mongodb:27017"
        - name: MongoDB__DatabaseName
          value: "ProductApp"
        ports:
        - containerPort: 8080
---
apiVersion: v1
kind: Service
metadata:
  name: authapi
spec:
  selector:
    app: authapi
  ports:
    - protocol: TCP
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: authapi
spec:
  selector:
    matchLabels:
      app: authapi
  template:
    metadata:
      labels:
        app: authapi
    spec:
      containers:
      - name: authapi
        image: kekorn/productapp-authapi
        imagePullPolicy: Always
        env:
        - name: ASPNETCORE_ENVIRONMENT
          value: "Production"
        - name: ConnectionStrings__MongoDB
          value: "mongodb://mongodb:27017"
        - name: MongoDB__DatabaseName
          value: "ProductApp"
        ports:
        - containerPort: 8080
---
apiVersion: v1
kind: Service
metadata:
  name: blazorui-service
spec:
  type: NodePort
  selector:
    app: blazorui
  ports:
    - protocol: TCP
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: blazorui
spec:
  selector:
    matchLabels:
      app: blazorui
  template:
    metadata:
      labels:
        app: blazorui
    spec:
      containers:
      - name: blazorui
        image: kekorn/productapp-blazorui
        imagePullPolicy: Always
        env:
        - name: ASPNETCORE_ENVIRONMENT
          value: "Production"
        - name: ASPNETCORE_URLS
          value: "http://+:8080"
        - name: ApiBaseUrl
          value: "http://webapi:8080/api/"
        - name: AuthApiUrl
          value: "http://authapi:8080"
        ports:
        - containerPort: 8080