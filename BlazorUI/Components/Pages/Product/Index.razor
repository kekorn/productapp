@page "/product"
@inject HttpClient Http
@inject NavigationManager Navigation
@using Shared.Dto
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer

<style>
    .table th:last-child {
        text-align: right !important;
    }
</style>

<AuthorizeView>
    <Authorized>
        <h3>Products</h3>

        <div class="mb-3">
            <a href="/product/create" class="btn btn-primary">Create New</a>
        </div>

        @if (products == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <div style="max-width: 900px; margin: 0 auto;">
                <div class="table-responsive">
                    <QuickGrid Items="@products.AsQueryable()" Pagination="@pagination" Class="table table-sm">
                        <PropertyColumn Property="@(p => p.ProductName)" Title="Name" />
                        <PropertyColumn Property="@(p => p.Price)" Title="Price" />
                        <PropertyColumn Property="@(p => p.Stock)" Title="Stock" />
                        <PropertyColumn Property="@(p => p.CategoryName)" Title="Category" />
                        <TemplateColumn Title="Actions" Context="product">
                            <div class="text-end">
                                <a href="/product/edit/@product.Id" class="btn btn-sm btn-warning">Edit</a>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteProduct(product.Id)">Delete</button>
                            </div>
                        </TemplateColumn>
                    </QuickGrid>
                </div>

                <div class="mt-3">
                    <Paginator State="@pagination" />
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-danger">
            You must be logged in to view products. <a href="/login">Login here</a>.
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<ProductDto>? products;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        try
        {
            products = await Http.GetFromJsonAsync<List<ProductDto>>("product") ?? new List<ProductDto>();
        }
        catch (HttpRequestException)
        {
            products = new List<ProductDto>();
        }
        catch (Exception)
        {
            products = new List<ProductDto>();
        }
    }

    private async Task DeleteProduct(string? id)
    {
        if (!string.IsNullOrEmpty(id))
        {
            var response = await Http.DeleteAsync($"product/{id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadProducts();
            }
        }
    }
}
