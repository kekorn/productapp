@page "/product"
@inject HttpClient Http
@inject NavigationManager Navigation
@using Shared.Dto
@using Microsoft.AspNetCore.Components.QuickGrid
@rendermode InteractiveServer

<h3>Products</h3>

<div class="mb-3">
    <a href="/product/create" class="btn btn-primary">Create New</a>
</div>

@if (products == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-responsive">
        <QuickGrid Items="@products.AsQueryable()" Pagination="@pagination" Class="table">
            <PropertyColumn Property="@(p => p.ProductID)" Title="ID" />
            <PropertyColumn Property="@(p => p.ProductName)" Title="Name" />
            <PropertyColumn Property="@(p => p.Price)" Title="Price" />
            <PropertyColumn Property="@(p => p.Stock)" Title="Stock" />
            <PropertyColumn Property="@(p => p.CategoryName)" Title="Category" />
            <TemplateColumn Title="Actions">
                <a href="/product/edit/@context.Id" class="btn btn-sm btn-warning">Edit</a>
                <button class="btn btn-sm btn-danger" @onclick="() => DeleteProduct(context.Id)">Delete</button>
            </TemplateColumn>
        </QuickGrid>
    </div>

    <div class="mt-3">
        <Paginator State="@pagination" />
    </div>
}

@code {
    private List<ProductDto>? products;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        try
        {
            products = await Http.GetFromJsonAsync<List<ProductDto>>("product") ?? new List<ProductDto>();
        }
        catch (HttpRequestException)
        {
            products = new List<ProductDto>();
        }
        catch (Exception)
        {
            products = new List<ProductDto>();
        }
    }

    private async Task DeleteProduct(string? id)
    {
        if (!string.IsNullOrEmpty(id))
        {
            var response = await Http.DeleteAsync($"product/{id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadProducts();
            }
        }
    }
}
