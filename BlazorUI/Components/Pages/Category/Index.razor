@page "/category"
@inject HttpClient Http
@inject NavigationManager Navigation
@using Shared.Dto
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer

<AuthorizeView>
    <Authorized>
        <h3>Categories</h3>

        <div class="mb-3">
            <a href="/category/create" class="btn btn-primary">Create New</a>
        </div>

        @if (categories == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <div style="max-width: 350px; margin: 0 auto;">
                <div class="table-responsive">
                    <QuickGrid Items="@categories.AsQueryable()" Pagination="@pagination" Class="table table-sm">
                        @* <PropertyColumn Property="@(c => c.CategoryID)" Title="ID" /> *@
                        <PropertyColumn Property="@(c => c.CName)" Title="Name" />
                        <TemplateColumn Title="Actions" Context="category" >
                            <div class="d-flex justify-content-end gap-1">
                                <a href="/category/edit/@category.Id" class="btn btn-sm btn-warning">Edit</a>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteCategory(category.Id)">Delete</button>
                            </div>
                        </TemplateColumn>
                    </QuickGrid>
                </div>

                <div class="mt-3">
                    <Paginator State="@pagination" />
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-danger">
            You must be logged in to view categories. <a href="/login">Login here</a>.
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<CategoryDto>? categories;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await Http.GetFromJsonAsync<List<CategoryDto>>("category") ?? new List<CategoryDto>();
        }
        catch (HttpRequestException)
        {
            categories = new List<CategoryDto>();
        }
        catch (Exception)
        {
            categories = new List<CategoryDto>();
        }
    }

    private async Task DeleteCategory(string? id)
    {
        if (!string.IsNullOrEmpty(id))
        {
            var response = await Http.DeleteAsync($"category/{id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadCategories();
            }
        }
    }
}
