@page "/category"
@inject HttpClient Http
@inject NavigationManager Navigation
@using Shared.Dto
@using Microsoft.AspNetCore.Components.QuickGrid
@rendermode InteractiveServer

<h3>Categories</h3>

<div class="mb-3">
    <a href="/category/create" class="btn btn-primary">Create New</a>
</div>

@if (categories == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-responsive">
        <QuickGrid Items="@categories.AsQueryable()" Pagination="@pagination" Class="table">
            <PropertyColumn Property="@(c => c.CategoryID)" Title="ID" />
            <PropertyColumn Property="@(c => c.CName)" Title="Name" />
            <TemplateColumn Title="Actions">
                <a href="/category/edit/@context.CategoryID" class="btn btn-sm btn-warning">Edit</a>
                <button class="btn btn-sm btn-danger" @onclick="() => DeleteCategory(context.CategoryID)">Delete</button>
            </TemplateColumn>
        </QuickGrid>
    </div>

    <div class="mt-3">
        <Paginator State="@pagination" />
    </div>
}

@code {
    private List<CategoryDto>? categories;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await Http.GetFromJsonAsync<List<CategoryDto>>("category") ?? new List<CategoryDto>();
        }
        catch (HttpRequestException)
        {
            categories = new List<CategoryDto>(); // Ha 404 vagy egyéb hiba van, akkor üres listát adunk
        }
        catch (Exception)
        {
            categories = new List<CategoryDto>();
        }
    }

    private async Task DeleteCategory(int id)
    {
        var response = await Http.DeleteAsync($"category/{id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadCategories();
        }
    }
}
